{
  "name": "agentic_stock_trader_autonomous",
  "description": "Autonomous stock trading agent: an LLM makes one trading decision per turn, workers execute it, and the market and account live in workflow variables",
  "version": 1,
  "schemaVersion": 2,
  "ownerEmail": "trader-demo@example.com",
  "inputParameters": ["instructions", "initial_balance", "llmProvider", "model"],
  "inputTemplate": {
    "initial_balance": 5000,
    "llmProvider": "openai",
    "model": "gpt-5-nano"
  },
  "tasks": [
    {
      "name": "init_account",
      "taskReferenceName": "init_account_ref",
      "type": "SET_VARIABLE",
      "inputParameters": {
        "balance": "${workflow.input.initial_balance}",
        "portfolio": {},
        "prices": {},
        "last_trade": "None yet"
      }
    },
    {
      "name": "trading_loop",
      "taskReferenceName": "trading_loop_ref",
      "type": "DO_WHILE",
      "inputParameters": {
        "change_percent": "${workflow.variables.change_percent}"
      },
      "loopCondition": "(function () {\n  return $.trading_loop_ref['iteration'] < 20 && Math.abs($.change_percent || 0) < 20;\n})();",
      "evaluatorType": "graaljs",
      "loopOver": [
        {
          "name": "update_market",
          "taskReferenceName": "update_market_ref",
          "type": "SIMPLE",
          "inputParameters": {
            "prices": "${workflow.variables.prices}",
            "portfolio": "${workflow.variables.portfolio}",
            "balance": "${workflow.variables.balance}",
            "starting_balance": "${workflow.input.initial_balance}"
          }
        },
        {
          "name": "record_market",
          "taskReferenceName": "record_market_ref",
          "type": "SET_VARIABLE",
          "inputParameters": {
            "prices": "${update_market_ref.output.prices}",
            "total_value": "${update_market_ref.output.total_value}",
            "change_percent": "${update_market_ref.output.change_percent}",
            "allocation": "${update_market_ref.output.allocation}"
          }
        },
        {
          "name": "decide_trade",
          "taskReferenceName": "decide_trade_ref",
          "type": "LLM_CHAT_COMPLETE",
          "inputParameters": {
            "llmProvider": "${workflow.input.llmProvider}",
            "model": "${workflow.input.model}",
            "reasoningEffort": "low",
            "jsonOutput": true,
            "messages": [
              {
                "role": "system",
                "message": "You are an autonomous stock trading agent managing a simulated account. Each turn you see the market prices, your cash and your holdings, and you make one decision to grow the account's total value (cash plus holdings at current prices). You can buy or sell a stock from the market, or hold to wait for better prices. Trade whole shares, only sell shares you hold, and never spend more cash than you have. Take profits, cut losses and spread your money across several stocks: keep at least 10% of the total value in cash, and no more than 40% in any one stock. Trading ends automatically when the change in total value reaches +20% or -20%, or after 20 turns. Reply only with JSON in this format: {\"action\": \"buy\" or \"sell\" or \"hold\", \"ticker\": \"<ticker from the market, or empty>\", \"quantity\": <number of shares, or 0>, \"reason\": \"<one short sentence>\"}"
              },
              {
                "role": "user",
                "message": "Instructions: ${workflow.input.instructions}\nStarting balance: ${workflow.input.initial_balance}\nCash: ${workflow.variables.balance}\nHoldings (shares by ticker): ${workflow.variables.portfolio}\nAllocation (% of total value): ${workflow.variables.allocation}\nMarket prices: ${workflow.variables.prices}\nTotal value: ${workflow.variables.total_value} (${workflow.variables.change_percent}% change)\nResult of your last decision: ${workflow.variables.last_trade}"
              }
            ]
          }
        },
        {
          "name": "execute_decision",
          "taskReferenceName": "execute_decision_ref",
          "type": "SWITCH",
          "evaluatorType": "value-param",
          "expression": "action",
          "inputParameters": {
            "action": "${decide_trade_ref.output.result.action}"
          },
          "decisionCases": {
            "buy": [
              {
                "name": "buy_stock",
                "taskReferenceName": "buy_stock_ref",
                "type": "SIMPLE",
                "inputParameters": {
                  "ticker": "${decide_trade_ref.output.result.ticker}",
                  "quantity": "${decide_trade_ref.output.result.quantity}",
                  "prices": "${workflow.variables.prices}",
                  "balance": "${workflow.variables.balance}",
                  "portfolio": "${workflow.variables.portfolio}"
                }
              },
              {
                "name": "record_buy",
                "taskReferenceName": "record_buy_ref",
                "type": "SET_VARIABLE",
                "inputParameters": {
                  "balance": "${buy_stock_ref.output.balance}",
                  "portfolio": "${buy_stock_ref.output.portfolio}",
                  "last_trade": "Turn ${trading_loop_ref.output.iteration}: ${buy_stock_ref.output.message} (${decide_trade_ref.output.result.reason})"
                }
              }
            ],
            "sell": [
              {
                "name": "sell_stock",
                "taskReferenceName": "sell_stock_ref",
                "type": "SIMPLE",
                "inputParameters": {
                  "ticker": "${decide_trade_ref.output.result.ticker}",
                  "quantity": "${decide_trade_ref.output.result.quantity}",
                  "prices": "${workflow.variables.prices}",
                  "balance": "${workflow.variables.balance}",
                  "portfolio": "${workflow.variables.portfolio}"
                }
              },
              {
                "name": "record_sell",
                "taskReferenceName": "record_sell_ref",
                "type": "SET_VARIABLE",
                "inputParameters": {
                  "balance": "${sell_stock_ref.output.balance}",
                  "portfolio": "${sell_stock_ref.output.portfolio}",
                  "last_trade": "Turn ${trading_loop_ref.output.iteration}: ${sell_stock_ref.output.message} (${decide_trade_ref.output.result.reason})"
                }
              }
            ],
            "hold": [
              {
                "name": "record_hold",
                "taskReferenceName": "record_hold_ref",
                "type": "SET_VARIABLE",
                "inputParameters": {
                  "last_trade": "Turn ${trading_loop_ref.output.iteration}: Held (${decide_trade_ref.output.result.reason})"
                }
              }
            ]
          },
          "defaultCase": [
            {
              "name": "record_unknown",
              "taskReferenceName": "record_unknown_ref",
              "type": "SET_VARIABLE",
              "inputParameters": {
                "last_trade": "Turn ${trading_loop_ref.output.iteration}: No trade made: unknown action ${decide_trade_ref.output.result.action}"
              }
            }
          ]
        }
      ]
    }
  ],
  "outputParameters": {
    "iterations": "${trading_loop_ref.output.iteration}",
    "starting_balance": "${workflow.input.initial_balance}",
    "total_value": "${workflow.variables.total_value}",
    "change_percent": "${workflow.variables.change_percent}",
    "cash": "${workflow.variables.balance}",
    "portfolio": "${workflow.variables.portfolio}",
    "prices": "${workflow.variables.prices}",
    "last_trade": "${workflow.variables.last_trade}"
  }
}
