{
  "name": "agentic_stock_trader_autonomous",
  "description": "Autonomous stock trading agent: an LLM picks each trade, workers execute it, and the account lives in workflow variables",
  "version": 1,
  "schemaVersion": 2,
  "ownerEmail": "trader-demo@example.com",
  "inputParameters": ["instructions", "initial_balance", "llmProvider", "model"],
  "inputTemplate": {
    "initial_balance": 3000,
    "llmProvider": "openai",
    "model": "gpt-5-nano"
  },
  "tasks": [
    {
      "name": "init_account",
      "taskReferenceName": "init_account_ref",
      "type": "SET_VARIABLE",
      "inputParameters": {
        "instructions": "${workflow.input.instructions}",
        "balance": "${workflow.input.initial_balance}",
        "portfolio": {},
        "last_trade": "None yet"
      }
    },
    {
      "name": "trading_loop",
      "taskReferenceName": "trading_loop_ref",
      "type": "DO_WHILE",
      "inputParameters": {
        "instructions": "${workflow.variables.instructions}"
      },
      "loopCondition": "(function () {\n  var next = String($.instructions || '').trim().toUpperCase();\n  return $.trading_loop_ref['iteration'] < 20 && next.indexOf('STOP') !== 0;\n})();",
      "evaluatorType": "graaljs",
      "loopOver": [
        {
          "name": "choose_trade",
          "taskReferenceName": "choose_trade_ref",
          "type": "LLM_CHAT_COMPLETE",
          "inputParameters": {
            "llmProvider": "${workflow.input.llmProvider}",
            "model": "${workflow.input.model}",
            "jsonOutput": true,
            "messages": [
              {
                "role": "system",
                "message": "You are a stock trading agent. Turn the instruction into exactly one trade. Reply only with JSON in this format: {\"command\": \"buy_stock\" or \"sell_stock\", \"ticker\": \"<NASDAQ ticker symbol>\", \"quantity\": <whole number of shares>}. You can only sell stocks in the portfolio. The current price is looked up for you."
              },
              {
                "role": "user",
                "message": "Instruction: ${workflow.variables.instructions}\nCash balance: ${workflow.variables.balance}\nPortfolio (shares by ticker): ${workflow.variables.portfolio}"
              }
            ]
          }
        },
        {
          "name": "execute_trade",
          "taskReferenceName": "execute_trade_ref",
          "type": "SWITCH",
          "evaluatorType": "value-param",
          "expression": "command",
          "inputParameters": {
            "command": "${choose_trade_ref.output.result.command}"
          },
          "decisionCases": {
            "buy_stock": [
              {
                "name": "get_stock_price",
                "taskReferenceName": "buy_price_ref",
                "type": "SIMPLE",
                "inputParameters": {
                  "ticker": "${choose_trade_ref.output.result.ticker}"
                }
              },
              {
                "name": "buy_stock",
                "taskReferenceName": "buy_stock_ref",
                "type": "SIMPLE",
                "inputParameters": {
                  "ticker": "${choose_trade_ref.output.result.ticker}",
                  "quantity": "${choose_trade_ref.output.result.quantity}",
                  "price": "${buy_price_ref.output.result}",
                  "balance": "${workflow.variables.balance}",
                  "portfolio": "${workflow.variables.portfolio}"
                }
              },
              {
                "name": "record_buy",
                "taskReferenceName": "record_buy_ref",
                "type": "SET_VARIABLE",
                "inputParameters": {
                  "balance": "${buy_stock_ref.output.balance}",
                  "portfolio": "${buy_stock_ref.output.portfolio}",
                  "last_trade": "${buy_stock_ref.output.message}"
                }
              }
            ],
            "sell_stock": [
              {
                "name": "get_stock_price",
                "taskReferenceName": "sell_price_ref",
                "type": "SIMPLE",
                "inputParameters": {
                  "ticker": "${choose_trade_ref.output.result.ticker}"
                }
              },
              {
                "name": "sell_stock",
                "taskReferenceName": "sell_stock_ref",
                "type": "SIMPLE",
                "inputParameters": {
                  "ticker": "${choose_trade_ref.output.result.ticker}",
                  "quantity": "${choose_trade_ref.output.result.quantity}",
                  "price": "${sell_price_ref.output.result}",
                  "balance": "${workflow.variables.balance}",
                  "portfolio": "${workflow.variables.portfolio}"
                }
              },
              {
                "name": "record_sell",
                "taskReferenceName": "record_sell_ref",
                "type": "SET_VARIABLE",
                "inputParameters": {
                  "balance": "${sell_stock_ref.output.balance}",
                  "portfolio": "${sell_stock_ref.output.portfolio}",
                  "last_trade": "${sell_stock_ref.output.message}"
                }
              }
            ]
          },
          "defaultCase": [
            {
              "name": "record_no_trade",
              "taskReferenceName": "record_no_trade_ref",
              "type": "SET_VARIABLE",
              "inputParameters": {
                "last_trade": "No trade made: unknown command ${choose_trade_ref.output.result.command}"
              }
            }
          ]
        },
        {
          "name": "decide_next_step",
          "taskReferenceName": "decide_next_step_ref",
          "type": "LLM_CHAT_COMPLETE",
          "inputParameters": {
            "llmProvider": "${workflow.input.llmProvider}",
            "model": "${workflow.input.model}",
            "messages": [
              {
                "role": "system",
                "message": "You are an autonomous stock trader managing a simulated account. Based on the account state, either give one short instruction for the next trade (buy one of the NASDAQ-100 stocks, or sell a stock from the portfolio), or respond with the single word STOP. Stop when the cash balance drops close to zero or grows to more than twice the starting balance. Reply with only the instruction or STOP, without explaining your reasoning."
              },
              {
                "role": "user",
                "message": "Starting balance: ${workflow.input.initial_balance}\nCash balance: ${workflow.variables.balance}\nPortfolio (shares by ticker): ${workflow.variables.portfolio}\nLast trade: ${workflow.variables.last_trade}"
              }
            ]
          }
        },
        {
          "name": "set_next_instructions",
          "taskReferenceName": "set_next_instructions_ref",
          "type": "SET_VARIABLE",
          "inputParameters": {
            "instructions": "${decide_next_step_ref.output.result}"
          }
        }
      ]
    }
  ],
  "outputParameters": {
    "iterations": "${trading_loop_ref.output.iteration}",
    "balance": "${workflow.variables.balance}",
    "portfolio": "${workflow.variables.portfolio}",
    "last_trade": "${workflow.variables.last_trade}",
    "last_instructions": "${workflow.variables.instructions}"
  }
}
